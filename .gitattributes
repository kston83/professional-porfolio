# Shell scripts must keep LF endings even when checked out on Windows —
# a CRLF shebang line makes bash fail with a confusing "bad interpreter"
# error, which would silently disable the git hooks in .claude/hooks/.
*.sh text eol=lf

# Husky hook files are shell scripts without a .sh extension — same CRLF
# risk applies.
.husky/* text eol=lf
